[0.540, "o", "\r\n"]
[0.012, "o", "\r\n\u001b[1momaforecast: what will the next Omarchy update do to your config?\u001b[0m\r\n\u001b[2mLooking for the incoming release…\u001b[0m\r\n"]
[0.860, "o", "Incoming: \u001b[36momarchy 4.0.3-1 → 4.0.4-1\u001b[0m \u001b[2m(signature not checked)\u001b[0m\r\n"]
[0.013, "o", "Pending migrations: \u001b[1m6\u001b[0m (they run as you, right after the packages install)\r\n"]
[1.053, "o", "\r\n \u001b[33m✗\u001b[0m \u001b[1m1788745941\u001b[0m  Update Kitty configuration\r\n"]
[0.004, "o", "     would modify ~/.config/kitty/kitty.conf \u001b[31m[you customized this]\u001b[0m\r\n"]
[0.003, "o", "     \u001b[2mkeeps a backup at ~/.config/kitty/kitty.conf.bak.Dx8QmZ\u001b[0m\r\n"]
[0.012, "o", "\r\n \u001b[33m✗\u001b[0m \u001b[1m1791968925\u001b[0m  Write the bar's tray where the bar drew it\r\n"]
[0.004, "o", "     would modify ~/.config/omarchy/shell.json \u001b[31m[you customized this]\u001b[0m\r\n"]
[0.014, "o", "\r\n \u001b[33m✗\u001b[0m \u001b[1m1791969355\u001b[0m  Split the bar's center section at its anchor into centerBegin, center and centerEnd\r\n"]
[0.003, "o", "     would modify ~/.config/omarchy/shell.json \u001b[31m[you customized this]\u001b[0m\r\n"]
[0.013, "o", "\r\n \u001b[33m✗\u001b[0m \u001b[1m1792020559\u001b[0m  Theme the Fcitx candidate window with the current Omarchy theme\r\n"]
[0.001, "o", "     would create ~/.config/fcitx5/conf/classicui.conf \u001b[2m[new file]\u001b[0m\r\n"]
[0.010, "o", "     \u001b[2malso wants to run:\u001b[0m\r\n       busctl --user --auto-start=no call org.fcitx.Fcitx5 /controller org.fcitx.Fcitx.Controlle\r\n"]
[0.007, "o", "\r\n \u001b[32m✓\u001b[0m \u001b[1m1792041364\u001b[0m  Install Gliff on aarch64, now that Omarchy's repositories build it there\r\n     \u001b[2mno changes to your config\u001b[0m\r\n"]
[0.011, "o", "\r\n \u001b[32m✓\u001b[0m \u001b[1m1792202836\u001b[0m  Let mpv and Chromium decode video on the video chip of Snapdragon laptops\r\n     \u001b[2mno changes to your config\u001b[0m\r\n"]
[0.164, "o", "\r\n\u001b[1mPackage files you edited by hand\u001b[0m\r\n The update replaces these with the new package's copy (files in /etc get a .pacnew instead):\r\n   /usr/share/omarchy/default/hypr/bindings/tiling.lua\r\n \u001b[2mMove those edits into ~/.config, where Omarchy expects overrides.\u001b[0m\r\n"]
[0.079, "o", "\r\n\u001b[1mNew Omarchy defaults you won't get automatically\u001b[0m\r\n Upstream changed these, but you've customized your copy, so the update leaves yours alone:\r\n   ~/.config/omarchy/shell.json\r\n"]
[0.004, "o", " \u001b[2mWhat changed upstream is in the full diff.\u001b[0m\r\n\r\n\u001b[1mSummary\u001b[0m\r\n \u001b[31m2 file(s) you changed would be rewritten.\u001b[0m Also: 0 stock, 1 new.\r\n"]
[0.001, "o", " Full diff: \u001b[36momaforecast check --diff\u001b[0m  (saved to ~/.local/state/omaforecast/last-forecast.diff)\r\n"]
[0.106, "o", " \u001b[32mSnapshot saved:\u001b[0m 20261017-133642-pre-update\r\n After the update, undo it with: \u001b[36momaforecast restore\u001b[0m  (or one file: omaforecast restore <path>)\r\n"]
[6.038, "o", "\u001b[H\u001b[2J\u001b[3J"]
